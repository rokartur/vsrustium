{
	"name": "comments",
	"publisher": "port",
	"displayName": "Port Comments",
	"version": "0.0.1",
	"description": "A comment controller with two threads on a.ts for port/tools/ui-pair.",
	"engines": { "vscode": "^1.100.0" },
	"main": "./extension.js",
	"activationEvents": ["onStartupFinished"],
	"contributes": {
		"commands": [
			{ "command": "port-comments.reply", "title": "Reply" },
			{ "command": "port-comments.resolve", "title": "Resolve", "icon": "$(check)" },
			{ "command": "port-comments.edit", "title": "Edit", "icon": "$(edit)" },
			{ "command": "port-comments.save", "title": "Save" }
		],
		"menus": {
			"comments/commentThread/context": [{ "command": "port-comments.reply", "group": "inline" }],
			"comments/commentThread/title": [{ "command": "port-comments.resolve", "group": "inline" }],
			"comments/comment/title": [{ "command": "port-comments.edit", "group": "inline", "when": "comment == editable" }],
			"comments/comment/context": [{ "command": "port-comments.save", "group": "inline" }]
		}
	}
}
