#!/bin/bash
# Pixel check: reference capture (CDP) against the port's Metal readback, per theme. Run from the repo root on the Studio.
# Prints "theme different anti_aliased total"; images land in $OUT. The port has no themes yet, so every theme is
# diffed against its one frame.
set -uo pipefail
OUT=${OUT:-/tmp/pixel-check}
mkdir -p "$OUT"
bun port/tools/ref-screenshot "$OUT/reference" >/dev/null
(cd native && cargo build --release -q -p app --features screenshot && cargo build --release -q -p pixeldiff)
VSCODE_GPUI_EXTENSIONS=${VSCODE_GPUI_EXTENSIONS:-$HOME/Developer/vscode-ref/extensions} \
  timeout 120 native/target/release/code-gpui --user-data-dir "$(mktemp -d)" --screenshot "$OUT/port.png"
for theme in dark light hc; do
  counts=$(native/target/release/pixeldiff "$OUT/reference/$theme.png" "$OUT/port.png" "$OUT/diff-$theme.png")
  echo "$theme $counts"
done
