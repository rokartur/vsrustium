#!/usr/bin/env bun
// Bundles the extension host for the native app into out-exthost/. Same bundle runs on Bun and Node.
// It is built from a copy of the VS Code tree's src/ (VSCODE_SRC) with port/patches/src-*.patch applied, and inlines
// product.json (port/product.json over it) and package.json as upstream's build does (src/bootstrap-meta.ts).
import { $, Glob } from 'bun';
import { mkdirSync, readFileSync, rmSync, symlinkSync, writeFileSync } from 'node:fs';
import { join, resolve } from 'node:path';
import { vscodeSrc } from './vscode-src.ts';

process.chdir(join(import.meta.dir, '../..'));
const build = 'out-exthost/build';
rmSync('out-exthost', { recursive: true, force: true });
mkdirSync(build, { recursive: true });
await $`cp -cR ${join(vscodeSrc, 'src')} ${build}/src`;
for (const patch of [...new Glob('port/patches/src-*.patch').scanSync()].sort()) {
	await $`patch -s -p1 -d ${build} -i ${resolve(patch)}`;
}

const readJson = (path: string) => JSON.parse(readFileSync(path, 'utf8'));
const product = { ...readJson(join(vscodeSrc, 'product.json')), ...readJson('port/product.json') };
const meta = join(build, 'src/bootstrap-meta.ts');
let source = readFileSync(meta, 'utf8');
for (const [marker, value] of [['BUILD_INSERT_PRODUCT_CONFIGURATION', product], ['BUILD_INSERT_PACKAGE_CONFIGURATION', readJson(join(vscodeSrc, 'package.json'))]]) {
	const placeholder = `{ ${marker}: '${marker}' }`;
	if (!source.includes(placeholder)) {
		throw new Error(`${meta}: no ${placeholder}`);
	}
	source = source.replace(placeholder, JSON.stringify(value));
}
writeFileSync(meta, source);

// The bundle keeps its packages external; Node and Bun resolve them from out-exthost/node_modules.
symlinkSync(join(vscodeSrc, 'node_modules'), 'out-exthost/node_modules');
await $`bun build ${build}/src/bootstrap-exthost.ts --target=node --format=esm --packages=external --outdir out-exthost`;
