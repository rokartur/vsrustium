#!/usr/bin/env bash
# Packs port/fixtures/extensions/vsix-* as VSIX files and runs port/fixtures/extensions/install-tests in vsrustium:
# installs and uninstalls them through the workbench commands while the host runs. Prints one line per check.
set -euo pipefail
cd "$(dirname "$0")/../.."
REF=${REF:-$HOME/Developer/vscode-ref}
out=$(mktemp -d)
for fixture in port/fixtures/extensions/vsix-*; do
  mkdir -p "$out/pack/extension" && rm -rf "$out/pack/extension"/* && cp -R "$fixture"/. "$out/pack/extension/"
  (cd "$out/pack" && zip -qr "$out/$(basename "$fixture").vsix" extension)
done
(cd native && cargo build --release -q -p app)
source port/tools/gui-lock.sh
tests=$PWD/port/fixtures/extensions/install-tests
code=0
PORT_VSIX_DIR=$out VSCODE_GPUI_EXTENSIONS=$REF/extensions timeout 120 native/target/release/vsrustium --user-data-dir "$out/user-data" \
  --extensionDevelopmentPath="$tests" --extensionTestsPath="$tests/tests" >"$out/log" 2>&1 || code=$?
grep -E '^(ok|FAILED) ' "$out/log" || cat "$out/log"
echo "exit $code"
rm -rf "$out"
exit "$code"
