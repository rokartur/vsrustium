#!/bin/bash
# Mirror this checkout to the Mac Studio and run a command there (bash -l, at the mirror root).
# Pushes HEAD to one bare repo on the Studio (git.git, only missing objects travel), points the mirror's index at it,
# runs `git clean` there (drops files deleted here), then copies only the files that differ: the mirror's modified files
# (changed by the new commits, or dirty in an earlier run) and this checkout's modified and untracked files.
# Ignored files on the Studio (node_modules, out, native/target) survive between runs.
# Each linked worktree gets its own mirror (port-src-<worktree>), first seeded as an APFS clone of port-src.
# Mirrors borrow git.git's objects through objects/info/alternates; git.git was cloned once from GitHub on the Studio.
set -euo pipefail
root=$(git -C "$(dirname "$0")" rev-parse --show-toplevel)
cd "$root"
work=Developer/vscode-gpui-work
name=port-src
if [[ $(git rev-parse --absolute-git-dir) != $(cd "$(git rev-parse --git-common-dir)" && pwd) ]]; then
  name=$name-$(basename "$root")
  ssh studio "cd ~/$work && test -d $name || cp -cR port-src $name"
fi
head=$(git rev-parse HEAD)
# The Studio repo has no LFS server; the two LFS files are copied below like any other file.
GIT_LFS_SKIP_PUSH=1 git push -qf "studio:$work/git.git" "HEAD:refs/mirror/$name"
stale=$(mktemp)
trap 'rm -f "$stale"' EXIT
# A mirror without alternates still has the full .git of the old rsync copy: replace it with a light one.
# A mixed reset moves only the index, so file mtimes and the cargo build stay as they are.
ssh studio "cd ~/$work/$name && bash -c 'test -f .git/objects/info/alternates || { rm -rf .git && git init -q && echo ~/$work/git.git/objects > .git/objects/info/alternates; }; git reset -q $head && git clean -fdq && git ls-files -m -z'" > "$stale"
# openrsync has no --ignore-missing-args: leave out tracked files deleted here.
cat "$stale" <(git ls-files -mo --exclude-standard -z) | sort -zu | { grep -zvxFf <(git -c core.quotepath=off ls-files -d) || true; } | rsync -az --from0 --files-from=- . "studio:$work/$name/"
git ls-files -d -z | ssh studio "cd ~/$work/$name && xargs -0 rm -f"
ssh studio "cd ~/$work/$name && bash -lc $(printf '%q' "$1")"
