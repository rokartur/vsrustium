#!/bin/bash
# Mirror this checkout to the Mac Studio and run a command there (bash -l, at the mirror root).
# Copies .git, runs `git clean` there (drops files deleted here), then copies every tracked and untracked non-ignored file.
# Ignored files on the Studio (node_modules, out, native/target) survive between runs.
# Each linked worktree gets its own mirror (port-src-<worktree>), first seeded as an APFS clone of port-src.
set -euo pipefail
root=$(git -C "$(dirname "$0")" rev-parse --show-toplevel)
cd "$root"
git_dir=$(git rev-parse --absolute-git-dir)
common_dir=$(cd "$(git rev-parse --git-common-dir)" && pwd)
remote_dir=Developer/vscode-gpui-work/port-src
if [[ $git_dir != "$common_dir" ]]; then
  remote_dir=$remote_dir-$(basename "$root")
  ssh studio "cd ~/Developer/vscode-gpui-work && test -d $(basename "$remote_dir") || cp -cR port-src $(basename "$remote_dir")"
fi
# Lock files are transient: another session's git command holds them for a moment and rsync fails on the vanished file.
rsync -az --delete --exclude /worktrees/ --exclude '*.lock' "$common_dir/" "studio:$remote_dir/.git/"
# A linked worktree keeps HEAD and index in its own git dir; the mirror is a plain checkout of that branch.
[[ $git_dir == "$common_dir" ]] || rsync -az "$git_dir/HEAD" "$git_dir/index" "studio:$remote_dir/.git/"
ssh studio "cd ~/$remote_dir && git clean -fdq"
git ls-files -co --exclude-standard -z | rsync -az --from0 --files-from=- . "studio:$remote_dir/"
ssh studio "cd ~/$remote_dir && bash -lc $(printf '%q' "$1")"
