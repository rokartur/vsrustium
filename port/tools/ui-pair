#!/usr/bin/env bun
// Drives the reference and the port through the same steps with cua-driver and saves window screenshots of both,
// for states a still pixel-check frame cannot reach (inline editors, dialogs, drags). Run on the Studio.
// Usage: port/tools/ui-pair <out-dir> <steps.json> [dark|light|hc|hclight]   (env REF = reference checkout,
// default ~/Developer/vscode-ref; env FOLDER = folder to open, default a copy of port/fixtures/workspace, empty for an empty window;
// env FILE = file to open, relative to the folder; env ONLY = "reference" or "port" to run one of them; env ARGS = more arguments for both, space separated;
// env SETTINGS = a JSON object of user settings for both)
// Steps, in window points (both windows are 1024x768):
//   {"click": [x, y]}  {"click": [x, y], "modifier": ["cmd"]}  {"click": [x, y], "foreground": true}  {"doubleClick": [x, y]}  {"rightClick": [x, y]}  {"key": "return"}  {"key": "escape", "foreground": true} (a real HID key down and up)
//   {"scroll": [x, y], "amount": notches} (real wheel notches down, the pointer left there)  {"hover": [x, y]} (the real pointer, for hovers)  {"hotkey": ["cmd", "c"]}  {"type": "text"}  {"wait": ms}  {"shot": "name"}  {"clipboard": "name"} (the pasteboard text, the folder path as <folder>)
//   {"dragShot": [x1, y1, x2, y2], "shot": "name", "modifier": ["option"], "button": "middle"}: a slow drag, captured while held
//   {"restart": true}: after the app quit (a Cmd+Q step), start it again on the same user data and folder
//   {"launch": ["docs/guide.md"]}: start the app a second time with these paths (relative to the folder), as a command line would
// Shots land in <out-dir>/<reference|port>-<name>.png at 2x; a sheet on the window is captured as its own window.
import { cpSync, mkdirSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from 'node:fs';
import { tmpdir } from 'node:os';
import { join, resolve } from 'node:path';
import { referenceArgs, referenceUserData } from './ref-user-data.ts';

type Step = { click?: number[]; scroll?: number[]; amount?: number; hover?: number[]; doubleClick?: number[]; rightClick?: number[]; modifier?: string[]; key?: string; hotkey?: string[]; type?: string; wait?: number; shot?: string; dragShot?: number[]; foreground?: boolean; clipboard?: string; button?: string; restart?: boolean; launch?: string[] };

const [outDir, stepsFile, themeName = 'dark'] = process.argv.slice(2);
const steps: Step[] = JSON.parse(readFileSync(stepsFile, 'utf8'));
const ref = process.env.REF ?? join(process.env.HOME!, 'Developer/vscode-ref');
const themes: Record<string, [string, string]> = {
	dark: ['Default Dark Modern', 'Dark Modern'],
	light: ['Default Light Modern', 'Light Modern'],
	hc: ['Default High Contrast', 'Default High Contrast'],
	hclight: ['Default High Contrast Light', 'Default High Contrast Light'],
};
const [referenceTheme, portTheme] = themes[themeName];
const extraArgs = process.env.ARGS?.split(' ') ?? [];
const settings: Record<string, unknown> = JSON.parse(process.env.SETTINGS ?? '{}');
mkdirSync(outDir, { recursive: true });
await takeGuiLock();

const scratch = mkdtempSync(join(tmpdir(), 'ui-pair-'));
for (const app of (process.env.ONLY ?? 'reference port').split(' ')) {
	const folder = process.env.FOLDER ?? join(scratch, app, 'workspace');
	if (process.env.FOLDER === undefined) {
		cpSync('port/fixtures/workspace', folder, { recursive: true });
	}
	const paths = process.env.FOLDER === '' ? [] : process.env.FILE ? [folder, join(folder, process.env.FILE)] : [folder];
	const userData = app === 'reference' ? referenceUserDataDir() : portUserDataDir();
	const start = (openPaths = paths) => app === 'reference' ? startReference(openPaths, userData) : startPort(openPaths, userData);
	let child = start();
	// A `restart` step: the app quit by the steps before it (Cmd+Q) starts again on the same user data.
	const restart = async () => {
		await Promise.race([child.exited, Bun.sleep(30000)]);
		child.kill('SIGKILL');
		child = start();
		return child.pid;
	};
	try {
		// A `launch` step: a second start on the same user data, which hands its paths to the running app and exits.
		const launch = async (relative: string[]) => {
			const second = start(relative.map(path => join(folder, path)));
			await Promise.race([second.exited, Bun.sleep(30000)]);
			second.kill('SIGKILL');
		};
		await run(app, child.pid, folder, restart, launch);
	} finally {
		child.kill('SIGKILL');
		await child.exited;
	}
}
rmSync(scratch, { recursive: true, force: true });
process.exit(0);

function referenceUserDataDir() {
	const userData = referenceUserData(referenceTheme, settings);
	// cua-driver reads the accessibility tree, which the reference takes for a screen reader (a notification
	// and "Screen Reader Optimized"); the port has no screen reader mode yet.
	const settingsFile = join(userData, 'User/settings.json');
	writeFileSync(settingsFile, JSON.stringify({ ...JSON.parse(readFileSync(settingsFile, 'utf8')), 'editor.accessibilitySupport': 'off' }));
	// windowsStateHandler.ts: the first window takes the last active window's size (WindowMode.Normal is 1).
	writeFileSync(join(userData, 'User/globalStorage/storage.json'), JSON.stringify({ windowsState: { lastActiveWindow: { uiState: { mode: 1, x: 100, y: 100, width: 1024, height: 768 } } } }));
	return userData;
}

function startReference(paths: string[], userData: string) {
	const electron = join(ref, '.build/electron/Code - OSS.app/Contents/MacOS/Code - OSS');
	return Bun.spawn([electron, ref, ...paths, ...referenceArgs, ...extraArgs, '--user-data-dir', userData, '--shared-data-dir', join(userData, 'shared')], {
		env: { ...process.env, VSCODE_DEV: '1', NODE_ENV: 'development' },
		stdout: 'ignore',
		stderr: 'ignore',
	});
}

function portUserDataDir() {
	const userData = mkdtempSync(join(scratch, 'port-user-'));
	mkdirSync(join(userData, 'User'));
	// Trust is off in referenceUserData; SETTINGS turns it on for both. cua-driver reads the accessibility tree, which
	// the port takes for a screen reader as the reference does, so both run with accessibility support off. Reduced
	// motion as in referenceUserData.
	writeFileSync(join(userData, 'User/settings.json'), JSON.stringify({ 'security.workspace.trust.enabled': false, 'workbench.startupEditor': 'none', 'editor.accessibilitySupport': 'off', 'workbench.reduceMotion': 'on', ...settings }));
	return userData;
}

function startPort(paths: string[], userData: string) {
	return Bun.spawn(['native/target/release/vsrustium', ...paths, ...extraArgs, '--user-data-dir', userData, '--shared-data-dir', join(userData, 'shared'), '--theme', portTheme], {
		env: { ...process.env, VSCODE_GPUI_EXTENSIONS: join(ref, 'extensions') },
		stdout: 'ignore',
		stderr: Bun.file(join(outDir, 'port.log')),
	});
}

async function run(app: string, firstPid: number, folder: string, restart: () => Promise<number>, launch: (paths: string[]) => Promise<void>) {
	let { window, target, scale } = await attach(app, firstPid);
	const at = (point: number[]) => ({ x: point[0] * scale, y: point[1] * scale });
	for (const step of steps) {
		if (step.click) {
			await cua('click', { ...target, ...at(step.click), modifier: step.modifier, delivery_mode: step.foreground ? 'foreground' : undefined });
		} else if (step.scroll) {
			// Electron drops background wheel events; both get the real pointer's.
			await cua('scroll', { ...target, ...at(step.scroll), direction: 'down', amount: step.amount ?? 3, delivery_mode: 'foreground' });
		} else if (step.hover) {
			// Editor hovers follow mouse moves, which only the real pointer sends; desktop coordinates are pixels.
			await cua('move_cursor', { scope: 'desktop', delivery_mode: 'foreground', x: (window.bounds.x + step.hover[0]) * scale, y: (window.bounds.y + step.hover[1]) * scale });
		} else if (step.doubleClick) {
			await cua('double_click', { ...target, ...at(step.doubleClick) });
		} else if (step.rightClick) {
			await cua('right_click', { ...target, ...at(step.rightClick) });
		} else if (step.key) {
			await cua('press_key', { ...target, key: step.key, delivery_mode: step.foreground ? 'foreground' : undefined });
		} else if (step.hotkey) {
			await cua('hotkey', { ...target, keys: step.hotkey });
		} else if (step.type) {
			// Key by key: type_text refuses windows without an accessible text field, as GPUI's.
			// press_key knows no shifted symbols: they go as shift plus the US layout's base key.
			const shifted: Record<string, string> = { '!': '1', '@': '2', '#': '3', '$': '4', '%': '5', '^': '6', '&': '7', '*': '8', '(': '9', ')': '0', '_': '-', '+': '=', '{': '[', '}': ']', '|': '\\', ':': ';', '"': "'", '<': ',', '>': '.', '?': '/', '~': '`' };
			for (const key of step.type) {
				if (shifted[key]) {
					await cua('press_key', { ...target, key: shifted[key], modifiers: ['shift'] });
				} else {
					await cua('press_key', { ...target, key: key === ' ' ? 'space' : key });
				}
			}
		} else if (step.wait) {
			await Bun.sleep(step.wait);
		} else if (step.launch) {
			await launch(step.launch);
		} else if (step.restart) {
			({ window, target, scale } = await attach(app, await restart()));
		} else if (step.dragShot) {
			const [x1, y1, x2, y2] = step.dragShot;
			// A background drag reaches only Electron's own drag and drop; GPUI needs the real pointer.
			// `foreground: true` sends the reference's drag through the real pointer too (a sash, not a drag and drop).
			const delivery_mode = app === 'port' || step.foreground ? 'foreground' : 'background';
			const drag = cua('drag', { ...target, from_x: x1 * scale, from_y: y1 * scale, to_x: x2 * scale, to_y: y2 * scale, duration_ms: 4000, steps: 40, modifier: step.modifier, button: step.button, delivery_mode });
			await Bun.sleep(3500);
			await shot(app, target.pid, target.window_id, step.shot!);
			await drag;
		} else if (step.shot) {
			await shot(app, target.pid, target.window_id, step.shot);
		} else if (step.clipboard) {
			const text = (await Bun.$`pbpaste`.text()).replaceAll(folder, '<folder>');
			writeFileSync(resolve(outDir, `${app}-${step.clipboard}.txt`), text);
			console.log(`${app}-${step.clipboard}.txt: ${JSON.stringify(text)}`);
			const html = await Bun.$`osascript -l JavaScript -e ${"ObjC.import('AppKit'); const h = $.NSPasteboard.generalPasteboard.stringForType('public.html'); h.isNil() ? '' : h.js"}`.text();
			if (html.trim()) {
				writeFileSync(resolve(outDir, `${app}-${step.clipboard}.html`), html.trimEnd());
				console.log(`${app}-${step.clipboard}.html: ${html.trimEnd()}`);
			}
		}
		await Bun.sleep(400);
	}
}

/** The app's 1024px window once the workbench settled. */
async function attach(app: string, pid: number) {
	const window = await until(async () => {
		const { windows } = await cua('list_windows', { pid });
		return windows.find((w: { bounds: { width: number }; is_on_screen: boolean }) => w.is_on_screen && w.bounds.width === 1024);
	}, 120000);
	// The workbench and its extensions settle after the window appears.
	await Bun.sleep(app === 'reference' ? 10000 : 6000);
	const target = { pid, window_id: window.window_id };
	// A first capture sets the screenshot pixel space the pixel actions use: 2x on a Retina display, 1x on a
	// headless or 1x one. The PNG's width (bytes 16 to 19 of its header) gives the scale.
	const probe = join(outDir, `.${app}-scale.png`);
	await cua('get_window_state', { ...target, include_accessibility_tree: false, max_image_dimension: 2048, screenshot_out_file: probe });
	const scale = readFileSync(probe).readUInt32BE(16) / window.bounds.width;
	rmSync(probe);
	return { window, target, scale };
}

/** The window, or the sheet over it when one is open. */
async function shot(app: string, pid: number, windowId: number, name: string) {
	type Listed = { window_id: number; is_on_screen: boolean; bounds: { width: number } };
	const { windows } = await cua('list_windows', { pid });
	// The port reopens its window when it enters a workspace: then the new 1024 wide window is the main one.
	const main = windows.some((w: Listed) => w.window_id === windowId && w.is_on_screen) ? windowId : windows.find((w: Listed) => w.is_on_screen && w.bounds.width === 1024)?.window_id ?? windowId;
	const sheet = windows.find((w: Listed) => w.is_on_screen && w.window_id !== main && w.bounds.width < 1024);
	const file = resolve(outDir, `${app}-${name}.png`);
	await cua('get_window_state', { pid, window_id: sheet?.window_id ?? main, include_accessibility_tree: false, max_image_dimension: 2048, screenshot_out_file: file });
	console.log(`${app}-${name}.png${sheet ? ' (sheet)' : ''}`);
}

async function cua(tool: string, args: object) {
	// One session for every call: the pixel actions use the screenshot space of the session's last read.
	const child = Bun.spawn(['cua-driver', 'call', tool, JSON.stringify({ session: 'ui-pair', ...args })], { stderr: 'pipe' });
	const [stdout, stderr, code] = await Promise.all([new Response(child.stdout).text(), new Response(child.stderr).text(), child.exited]);
	if (code !== 0) {
		throw new Error(`cua-driver ${tool}: ${stderr}${stdout}`);
	}
	return JSON.parse(stdout);
}

/** gui-lock.sh's lock: windows of parallel sessions take turns. */
async function takeGuiLock() {
	const lock = '/tmp/port-gui.lock';
	while (true) {
		try {
			mkdirSync(lock);
			writeFileSync(join(lock, 'pid'), String(process.pid));
			process.on('exit', () => rmSync(lock, { recursive: true, force: true }));
			return;
		} catch {
			const owner = Number(await Bun.file(join(lock, 'pid')).text().catch(() => '0'));
			if (owner && !isAlive(owner)) {
				rmSync(lock, { recursive: true, force: true });
				continue;
			}
			await Bun.sleep(5000);
		}
	}
}

function isAlive(pid: number) {
	try {
		process.kill(pid, 0);
		return true;
	} catch {
		return false;
	}
}

async function until<T>(probe: () => Promise<T>, timeoutMs = 60000): Promise<NonNullable<T>> {
	const deadline = Date.now() + timeoutMs;
	while (Date.now() < deadline) {
		const value = await probe().catch(() => undefined);
		if (value) {
			return value;
		}
		await Bun.sleep(250);
	}
	throw new Error('timed out');
}
