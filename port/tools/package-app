#!/usr/bin/env bun
// Packages VSRustium.app (roadmap section 19): the release binary and bun in Contents/MacOS; product.json,
// package.json, the extension host bundle, the shipped built-in extensions (port/tools/shipped-files.ts) with the
// packages they and the host resolve, and the upstream media the workbench reads, in Contents/Resources/app;
// Info.plist with the reference's document types and the vsrustium URL protocol; then codesign with the hardened
// runtime and `spctl -a`. Run on the Studio after a release build and port/tools/build-exthost:
//   port/tools/studio 'port/tools/package-app'    env IDENTITY="Developer ID Application: ..." (default ad-hoc "-";
//   a Developer ID signs in the GUI session), NOTARIZE=1 (notarize and staple), VSCODE_GPUI_EXTENSIONS (default the reference's extensions), OUT (default native/target/VSRustium.app)
import { cpSync, existsSync, mkdirSync, readFileSync, realpathSync, rmSync, symlinkSync, writeFileSync } from 'node:fs';
import { basename, dirname, join, relative } from 'node:path';
import { inertPackages, shippedBuiltins } from './shipped-files.ts';

const root = process.cwd();
const ref = process.env.REF ?? join(process.env.HOME!, 'Developer/vscode-ref');
const extensionsDir = process.env.VSCODE_GPUI_EXTENSIONS ?? join(ref, 'extensions');
const out = process.env.OUT ?? join(root, 'native/target/VSRustium.app');
const identity = process.env.IDENTITY ?? '-';
const product = JSON.parse(readFileSync('product.json', 'utf8'));
const version = JSON.parse(readFileSync('package.json', 'utf8')).version;

rmSync(out, { recursive: true, force: true });
const contents = join(out, 'Contents');
const app = join(contents, 'Resources/app');
mkdirSync(join(contents, 'MacOS'), { recursive: true });
mkdirSync(app, { recursive: true });

cpSync('native/target/release/vsrustium', join(contents, 'MacOS/vsrustium'));
cpSync(realpathSync(Bun.which('bun')!), join(contents, 'MacOS/bun'));
for (const file of ['product.json', 'package.json', 'out-exthost/bootstrap-exthost.js']) {
	cpSync(file, join(app, file));
}
// The upstream files the workbench reads at runtime (accessibility_signals.rs, workbench.rs, webview_panels.rs).
for (const dir of ['src/vs/platform/accessibilitySignal/browser/media', 'src/vs/workbench/browser/parts/editor/media', 'src/vs/workbench/contrib/webview/browser/pre']) {
	cpSync(dir, join(app, dir), { recursive: true });
}

// Packages keep pnpm's layout: each .pnpm/<id> entry is copied whole with its relative links, and a package a
// built-in or the host needs is linked from its node_modules folder to that entry.
const copiedEntries = new Set<string>();
const visited = new Set<string>();
function copyPackage(realPath: string): string {
	const marker = '/node_modules/.pnpm/';
	const at = realPath.indexOf(marker);
	if (at < 0) {
		throw new Error(`not a pnpm package: ${realPath}`);
	}
	const entryId = realPath.slice(at + marker.length).split('/')[0];
	if (!copiedEntries.has(entryId)) {
		copiedEntries.add(entryId);
		cpSync(realPath.slice(0, at + marker.length) + entryId, join(app, 'node_modules/.pnpm', entryId), { recursive: true, verbatimSymlinks: true });
	}
	return join(app, 'node_modules/.pnpm', realPath.slice(at + marker.length));
}
function resolvePackage(name: string, from: string): string | undefined {
	for (let dir = realpathSync(from); ; dir = dirname(dir)) {
		const candidate = join(dir, 'node_modules', name);
		if (existsSync(join(candidate, 'package.json'))) {
			return realpathSync(candidate);
		}
		if (dir === dirname(dir)) {
			return undefined;
		}
	}
}
// Copies the dependencies of the package at `dir` (a real path) transitively; returns name -> copied path.
function copyDependencies(dir: string, names: string[]): Map<string, string> {
	const copied = new Map<string, string>();
	for (const name of names) {
		if (inertPackages.includes(name)) {
			continue;
		}
		const found = resolvePackage(name, dir);
		if (!found) {
			continue;
		}
		copied.set(name, copyPackage(found));
		if (!visited.has(found)) {
			visited.add(found);
			const manifest = JSON.parse(readFileSync(join(found, 'package.json'), 'utf8'));
			copyDependencies(found, Object.keys({ ...manifest.dependencies, ...manifest.optionalDependencies }));
		}
	}
	return copied;
}
function link(target: string, at: string) {
	mkdirSync(dirname(at), { recursive: true });
	symlinkSync(relative(dirname(at), target), at);
}

const skipped = /(^|\/)(src|test|tests|node_modules|\.vscode)(\/|$)|\.(ts|map)$/;
for (const extension of shippedBuiltins(extensionsDir)) {
	const target = join(app, 'extensions', basename(extension));
	cpSync(extension, target, { recursive: true, filter: source => !skipped.test(relative(extension, source)) });
	const manifest = JSON.parse(readFileSync(join(extension, 'package.json'), 'utf8'));
	for (const [name, path] of copyDependencies(extension, Object.keys({ ...manifest.dependencies, ...manifest.optionalDependencies }))) {
		link(path, join(target, 'node_modules', name));
	}
}
// typescript-language-features runs the TypeScript the build puts in extensions/node_modules (typescript.tsdk default).
for (const [name, path] of copyDependencies(extensionsDir, ['typescript'])) {
	link(path, join(app, 'extensions/node_modules', name));
}
// The extension host bundle keeps its packages external; codicons and ripgrep are read by the workbench and search,
// vscode-languagedetection by the language detection worker.
const hostPackages = ['@vscode/proxy-agent', '@vscode/ripgrep-universal', '@vscode/spdlog', 'http-proxy-agent', 'https-proxy-agent', 'kerberos', 'minimist', 'undici', 'vscode-regexpp', '@vscode/codicons', '@vscode/vscode-languagedetection'];
for (const [name, path] of copyDependencies(root, hostPackages)) {
	link(path, join(app, 'node_modules', name));
}

// A pnpm entry links its dev and peer dependencies too; the ones not copied would dangle, and codesign --strict
// refuses a bundle with a dangling link.
const dangling = (await Bun.$`find ${app} -type l ${['!', '-exec', 'test', '-e', '{}', ';', '-print', '-delete']}`.text()).split('\n').filter(Boolean);
console.log(`removed ${dangling.length} links to packages that are not shipped`);

// Info.plist: the reference build's document types (build/lib/electron.ts), the port's names and URL protocol.
const reference = JSON.parse(await Bun.$`plutil -convert json -o - ${join(ref, '.build/electron/Code - OSS.app/Contents/Info.plist')}`.text());
const plist = {
	CFBundleDevelopmentRegion: 'en',
	CFBundleDisplayName: product.nameLong,
	CFBundleName: product.nameShort,
	CFBundleExecutable: 'vsrustium',
	CFBundleIconFile: 'AppIcon',
	CFBundleIconName: 'AppIcon',
	CFBundleIdentifier: product.darwinBundleIdentifier,
	CFBundleInfoDictionaryVersion: '6.0',
	CFBundlePackageType: 'APPL',
	CFBundleShortVersionString: version,
	CFBundleVersion: version,
	CFBundleDocumentTypes: reference.CFBundleDocumentTypes,
	CFBundleURLTypes: [{ CFBundleTypeRole: 'Viewer', CFBundleURLName: product.nameLong, CFBundleURLSchemes: [product.urlProtocol] }],
	LSApplicationCategoryType: 'public.app-category.developer-tools',
	LSMinimumSystemVersion: '12.0',
	NSHighResolutionCapable: true,
	NSSupportsAutomaticGraphicsSwitching: true,
	NSPrincipalClass: 'NSApplication',
	NSHumanReadableCopyright: 'Copyright (C) Microsoft Corporation and VSRustium contributors. MIT License.',
};
writeFileSync(join(contents, 'Info.plist.json'), JSON.stringify(plist));
await Bun.$`plutil -convert xml1 -o ${join(contents, 'Info.plist')} ${join(contents, 'Info.plist.json')}`;
rmSync(join(contents, 'Info.plist.json'));
writeFileSync(join(contents, 'PkgInfo'), 'APPL????');
// actool writes Assets.car (the Liquid Glass icon in every appearance) and AppIcon.icns (macOS 15 and older); it
// exits 0 without writing either when the .icon folder is not named AppIcon.icon, and fails on a relative path.
await Bun.$`xcrun actool ${join(root, 'resources/darwin/AppIcon.icon')} --compile ${join(contents, 'Resources')} --platform macosx --minimum-deployment-target ${plist.LSMinimumSystemVersion} --app-icon AppIcon --output-partial-info-plist /dev/null --errors`;
if (!existsSync(join(contents, 'Resources/Assets.car')) || !existsSync(join(contents, 'Resources/AppIcon.icns'))) {
	throw new Error('actool wrote no app icon');
}
for (const icon of new Set<string>(reference.CFBundleDocumentTypes.map((type: { CFBundleTypeIconFile: string }) => type.CFBundleTypeIconFile))) {
	cpSync(join('resources/darwin', icon), join(contents, 'Resources', icon));
}

// Every Mach-O inside is signed first (native modules, ripgrep, bun), then the app; bun needs JIT and the
// executable memory of JavaScriptCore, and loads native modules signed by others.
const entitlements = join(contents, '..', '..', 'vsrustium.entitlements');
writeFileSync(entitlements, `<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>com.apple.security.cs.allow-jit</key><true/>
<key>com.apple.security.cs.allow-unsigned-executable-memory</key><true/>
<key>com.apple.security.cs.disable-library-validation</key><true/>
</dict></plist>
`);
const machO = (await Bun.$`find ${app} -type f ${['(', '-name', '*.node', '-o', '-name', '*.dylib', '-o', '-perm', '-u+x', ')']}`.text()).split('\n').filter(Boolean);
const binaries = [];
for (const file of machO) {
	if ((await Bun.$`file -b ${file}`.text()).startsWith('Mach-O')) {
		binaries.push(file);
	}
}
const timestamp = identity === '-' ? '--timestamp=none' : '--timestamp';
// The Developer ID key sits in the login keychain, which stays locked in an ssh session (errSecInternalComponent):
// signing with it runs as a script opened in the GUI session.
const keychain = identity === '-' ? '' : `--keychain ${shellQuote(join(process.env.HOME!, 'Library/Keychains/login.keychain-db'))}`;
const sign = (paths: string[], withEntitlements: boolean) =>
	`codesign --force ${timestamp} --options runtime ${keychain} --sign ${shellQuote(identity)} ${withEntitlements ? `--entitlements ${shellQuote(entitlements)}` : ''} ${paths.map(shellQuote).join(' ')}`;
const commands = [...(binaries.length ? [sign(binaries, false)] : []), sign([join(contents, 'MacOS/bun')], true), sign([out], true)];
const signed = identity === '-' ? await Bun.$`bash -ec ${commands.join('\n')}`.nothrow() : await inGuiSession('sign', commands);
rmSync(entitlements);
if (signed.exitCode !== 0) {
	console.log(`codesign failed: ${signed.stderr.toString().trim()}`);
	process.exit(1);
}

// NOTARIZE=1 submits the signed app with the notarytool profile vsrustium-notary (stored once by Artur in the
// Studio's login keychain: xcrun notarytool store-credentials vsrustium-notary --apple-id <id> --team-id N529W98U62)
// and staples the ticket.
if (process.env.NOTARIZE === '1') {
	const zip = `${out}.zip`;
	const notarized = await inGuiSession('notarize', [
		`ditto -c -k --keepParent ${shellQuote(out)} ${shellQuote(zip)}`,
		`xcrun notarytool submit ${shellQuote(zip)} --keychain-profile vsrustium-notary --wait`,
		`xcrun stapler staple ${shellQuote(out)}`,
	]);
	rmSync(zip, { force: true });
	console.log(`notarization: exit ${notarized.exitCode}\n${notarized.stderr.toString().trim()}`);
	if (notarized.exitCode !== 0) {
		process.exit(1);
	}
}
const verify = await Bun.$`codesign --verify --deep --strict --verbose=2 ${out}`.nothrow();
console.log(`${out}: ${binaries.length + 2} signatures as ${identity}, codesign --verify ${verify.exitCode === 0 ? 'ok' : 'failed'}`);
console.log(verify.stderr.toString().trim());
const size = (await Bun.$`du -sh ${out}`.text()).split('\t')[0];
console.log(`size ${size}`);
// With Gatekeeper assessments disabled (`spctl --master-disable`) spctl accepts any bundle: the check cannot fail.
const status = (await Bun.$`spctl --status`.nothrow().text()).trim();
if (status !== 'assessments enabled') {
	console.log(`spctl -a: not assessed, Gatekeeper reports "${status}"`);
	process.exit(verify.exitCode || 3);
}
const assessment = await Bun.$`spctl -a -vv ${out}`.nothrow();
console.log(`spctl -a: exit ${assessment.exitCode}: ${assessment.stderr.toString().trim()}`);
process.exit(verify.exitCode || assessment.exitCode);

function shellQuote(value: string) {
	return `'${value.replaceAll("'", `'\\''`)}'`;
}

// Runs the commands in a .command script that Terminal opens in the GUI session, and waits for its exit code.
async function inGuiSession(name: string, commands: string[]) {
	const base = `/tmp/vsrustium-${name}-${process.pid}`;
	const done = `${base}.done`;
	rmSync(done, { force: true });
	writeFileSync(`${base}.command`, `#!/bin/bash\n( set -e\n${commands.join('\n')}\n) >${shellQuote(`${base}.log`)} 2>&1\necho $? >${shellQuote(done)}\n`, { mode: 0o755 });
	await Bun.$`open ${`${base}.command`}`;
	// notarytool --wait takes minutes; an hour without the done file means Terminal never ran the script.
	for (let waited = 0; !existsSync(done) || !readFileSync(done, 'utf8').trim(); waited++) {
		if (waited > 3600) {
			throw new Error(`${base}.command did not finish in an hour (is a GUI session logged in?)`);
		}
		await Bun.sleep(1000);
	}
	const exitCode = Number(readFileSync(done, 'utf8'));
	const log = readFileSync(`${base}.log`, 'utf8');
	for (const file of [`${base}.command`, `${base}.log`, done]) {
		rmSync(file, { force: true });
	}
	return { exitCode, stderr: Buffer.from(log) };
}
